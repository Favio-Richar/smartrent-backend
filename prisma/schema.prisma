// =============================================================
// SMARTRENT+ - Prisma Schema (PostgreSQL)
// Versión multimedia final 2025 (con módulo Soporte completo)
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================
// ENUMS
// =============================================================
enum PropertyState {
  draft
  published
  paused
  archived
}

// =============================================================
// USERS
// =============================================================
model User {
  id         Int     @id @default(autoincrement())
  nombre     String
  correo     String  @unique
  email      String? @unique
  contrasena String
  telefono   String?
  ciudad     String?
  imagen     String?
  bio        String? @db.Text
  facebook   String?
  instagram  String?
  linkedin   String?
  web        String?
  whatsapp   String?     // 👈 AGREGADO
  tipoCuenta String  @default("Usuario")

  // 🔥 AGREGADO → Nivel de suscripción para roles

  suscripcionNivel String @default("free")

  fechaRegistro    DateTime  @default(now())
  isActive         Boolean   @default(true)
  lastLogin        DateTime?
  resetCode        String?
  resetCodeExpires DateTime?

  publicaciones       Property[]
  empleos             Job[]                 @relation("UserJobs")
  favoritos           Favorite[]
  comentarios         Comment[]
  postulaciones       Application[]
  tickets             SupportTicket[]
  reservations        Reservation[]
  feedbacks           Feedback[]
  SubscriptionPayment SubscriptionPayment[]
  ActiveSubscription  ActiveSubscription[]
  invoices            Invoice[] // 🔥 AGREGADO
  Company             Company[]
  ratings             Rating[]
  reactions           Reaction[]
  portada    String?     // 👈 AGREGADO

    // ===========================
  // CONFIGURACIONES DE PERFIL
  // ===========================

  darkMode         Boolean  @default(false)
  animacionesPerfil Boolean @default(true)
  mostrarPortada   Boolean  @default(true)
  estiloTarjetas   String?  @default("moderno")
  colorTema        String?  @default("azul")
  fontSize         Float?   @default(1.0)

  // PRIVACIDAD
  perfilPrivado    Boolean  @default(false)
  mostrarRedes     Boolean  @default(true)
  mostrarContacto  Boolean  @default(true)


  profilePosts    ProfilePost[]
  profileLikes    ProfileLike[]
  profileComments ProfileComment[]

  @@index([tipoCuenta])
  @@index([fechaRegistro])
  @@index([resetCode])
}

// =============================================================
// COMPANIES
// =============================================================
model Company {
  id            Int     @id @default(autoincrement())
  rutEmpresa    String?
  nombreEmpresa String
  correo        String  @unique
  contrasena    String

  telefono    String?
  direccion   String?
  descripcion String?
  logo        String?

  encargado     String?
  dueno         String?
  horaApertura  String?
  horaCierre    String?
  diasOperacion String?
  sitioWeb      String?

  userId Int?  @db.Integer
  user   User? @relation(fields: [userId], references: [id])

  fechaRegistro DateTime @default(now())

  empleos     Job[]
  propiedades Property[]

  @@index([fechaRegistro])
}

// =============================================================
// PROPERTIES
// =============================================================
model Property {
  id               Int      @id @default(autoincrement())
  titulo           String
  descripcion      String
  precio           Float
  categoria        String
  ubicacion        String?
  comuna           String?
  tipo             String?
  imagen           String?
  images           String[] @default([])
  videoUrl         String?
  videos           String[] @default([])
  latitude         Float?
  longitude        Float?
  destacado        Boolean  @default(false)
  area             Int?
  dormitorios      Int?
  banos            Int?
  anio             Int?
  fechaPublicacion DateTime @default(now())
  metadata         Json?
  companyName      String?
  contactName      String?
  contactPhone     String?
  contactEmail     String?
  whatsapp         String?
  website          String?

  // 📊 Métricas
  visitas  Int           @default(0)
  reservas Int           @default(0)
  state    PropertyState @default(draft)
  status   String?
  views    Int           @default(0)

  // 📅 Fechas
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 🔗 Relaciones
  userId    Int?
  companyId Int?

  user         User?         @relation(fields: [userId], references: [id])
  company      Company?      @relation(fields: [companyId], references: [id])
  comentarios  Comment[]
  favoritos    Favorite[]
  reservations Reservation[]
  ratings      Rating[]
  reactions    Reaction[]

  @@index([categoria])
  @@index([comuna])
  @@index([tipo])
  @@index([precio])
  @@index([fechaPublicacion])
  @@index([state])
  @@index([status])
  @@index([userId])
  @@index([companyId])
}

// =============================================================
// JOBS
// =============================================================
model Job {
  id               Int      @id @default(autoincrement())
  titulo           String
  descripcion      String
  categoria        String
  tipoContrato     String
  ubicacion        String
  salario          Float?
  fechaPublicacion DateTime @default(now())

  companyId Int?
  userId    Int?

  company       Company?      @relation(fields: [companyId], references: [id])
  user          User?         @relation("UserJobs", fields: [userId], references: [id])
  postulaciones Application[]
  favoritos     Favorite[]

  @@index([categoria])
  @@index([tipoContrato])
  @@index([fechaPublicacion])
}

// =============================================================
// APPLICATIONS
// =============================================================
model Application {
  id               Int      @id @default(autoincrement())
  userId           Int
  jobId            Int
  fechaPostulacion DateTime @default(now())
  estado           String   @default("En revisión")

  user User @relation(fields: [userId], references: [id])
  job  Job  @relation(fields: [jobId], references: [id])

  @@index([userId])
  @@index([jobId])
  @@index([estado])
  @@index([fechaPostulacion])
}

// =============================================================
// SUBSCRIPTIONS
// =============================================================
model Subscription {
  id           Int     @id @default(autoincrement())
  nombrePlan   String
  precio       Float
  descripcion  String?
  duracionDias Int
  nivel        String

  @@index([nivel])
}

// =============================================================
// FAVORITES
// =============================================================
model Favorite {
  id         Int  @id @default(autoincrement())
  userId     Int
  propertyId Int?
  jobId      Int?

  user     User      @relation(fields: [userId], references: [id])
  property Property? @relation(fields: [propertyId], references: [id])
  job      Job?      @relation(fields: [jobId], references: [id])

  @@index([userId])
  @@index([propertyId])
  @@index([jobId])
}

// =============================================================
// COMMENTS
// =============================================================
model Comment {
  id         Int      @id @default(autoincrement())
  contenido  String
  fecha      DateTime @default(now())
  userId     Int
  propertyId Int?

  user     User      @relation(fields: [userId], references: [id])
  property Property? @relation(fields: [propertyId], references: [id])

  @@index([userId])
  @@index([propertyId])
  @@index([fecha])
}

// =============================================================
// SUPPORT TICKETS
// =============================================================
model SupportTicket {
  id          Int      @id @default(autoincrement())
  subject     String
  description String
  category    String?  @default("General")
  imageBase64 String?
  status      String   @default("Pendiente")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id])
  respuesta   String?  @db.Text

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// =============================================================
// FEEDBACK
// =============================================================
model Feedback {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String?
  respuesta String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  userId    Int?

  user User? @relation(fields: [userId], references: [id])

  @@index([rating])
  @@index([createdAt])
}

// =============================================================
// FAQ
// =============================================================
model Faq {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String
  createdAt DateTime @default(now())
}

// =============================================================
// RESERVATIONS
// =============================================================
model Reservation {
  id         Int      @id @default(autoincrement())
  propertyId Int
  userId     Int
  startDate  DateTime
  endDate    DateTime
  message    String?  @db.Text
  people     Int      @default(1)
  status     String   @default("Pendiente")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([propertyId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// =============================================================
// COMMUNITY POSTS
// =============================================================
model CommunityPost {
  id        Int      @id @default(autoincrement())
  author    String
  title     String
  body      String
  createdAt DateTime @default(now())
}

// =============================================================
// PAGOS Y SUSCRIPCIONES
// =============================================================
model SubscriptionPayment {
  id                Int       @id @default(autoincrement())
  userId            Int
  plan              String
  buyOrder          String
  token             String    @unique
  amount            Int
  status            String    @default("PENDING")
  paymentType       String?
  authorizationCode String?
  cardLast4         String?
  transactionDate   DateTime?
  confirmedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime? @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  invoices Invoice[] // 🔥 AGREGADO — relación inversa

  @@index([userId])
  @@index([plan])
  @@index([status])
  @@index([createdAt])
  @@index([token, status])
}

model ActiveSubscription {
  id     Int    @id @default(autoincrement())
  userId Int
  plan   String

  // 🔥 AGREGADO → nivel del plan (pro, premium, advance)
  nivel String @default("basic")

  startDate DateTime @default(now())
  endDate   DateTime
  autoRenew Boolean  @default(true)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, plan, status])
  @@index([userId])
  @@index([plan])
  @@index([status])
  @@index([endDate])
}

// =============================================================
// INVOICES (Boletas PDF generadas por WebPay)
// =============================================================
model Invoice {
  id                Int      @id @default(autoincrement())
  userId            Int
  paymentId         Int // relación con SubscriptionPayment
  pdfUrl            String // ruta del archivo PDF generado
  amount            Int
  plan              String
  authorizationCode String?
  last4             String?
  createdAt         DateTime @default(now())

  user    User                @relation(fields: [userId], references: [id])
  payment SubscriptionPayment @relation(fields: [paymentId], references: [id])

  @@index([userId])
  @@index([paymentId])
}

// =============================================================
// RATINGS (CALIFICACIÓN DE PROPIEDADES)
// =============================================================
model Rating {
  id         Int      @id @default(autoincrement())
  score      Int // 1 a 5
  userId     Int
  propertyId Int
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])

  @@unique([userId, propertyId]) // ✔ evita calificar dos veces
  @@index([propertyId])
}

// =============================================================
// REACTIONS (LIKE / LOVE / WOW / FIRE)
// =============================================================
model Reaction {
  id         Int      @id @default(autoincrement())
  tipo       String // like, love, wow, fire
  userId     Int
  propertyId Int
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])

  @@unique([userId, propertyId, tipo]) // ✔ evita spamear reacciones
  @@index([propertyId])
}

model ProfilePost {
  id          Int       @id @default(autoincrement())
  userId      Int
  tipo        String    @default("text") // text | image | video
  texto       String
  titulo      String?                      // opcional
  imagen      String?                      // URL de imagen
  video       String?                      // URL de video
  miniatura   String?                      // thumbnail para videos
  duracion    Int?                         // duración del video en segundos
  ubicacion   String?                      // lugar del post
  tags        String?                      // "#departamento,#arriendo"
  isPublic    Boolean   @default(true)     // público o privado

  createdAt   DateTime  @default(now())
  editedAt    DateTime?                     // se actualiza si editas el post

  // Relaciones
  likes       ProfileLike[]
  comments    ProfileComment[]

  // repost (como compartir publicación)
  repostId    Int?
  repost      ProfilePost?   @relation("RepostRelation", fields: [repostId], references: [id])
  repostedBy  ProfilePost[]  @relation("RepostRelation")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tipo])
  @@index([createdAt])
}



model ProfileLike {
  id        Int      @id @default(autoincrement())
  userId    Int
  postId    Int
  createdAt DateTime @default(now())

  user User        @relation(fields: [userId], references: [id])
  post ProfilePost @relation(fields: [postId], references: [id])

  @@unique([userId, postId]) // evita doble like
}

model ProfileComment {
  id         Int      @id @default(autoincrement())
  postId     Int
  userId     Int
  comentario String
  createdAt  DateTime @default(now())

  post ProfilePost @relation(fields: [postId], references: [id])
  user User        @relation(fields: [userId], references: [id])
}
