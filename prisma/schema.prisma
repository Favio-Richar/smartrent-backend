// =============================================================
// SMARTRENT+ - Prisma Schema (PostgreSQL)
// Versión multimedia final 2025 (con módulo Soporte completo)
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================
// ENUMS
// =============================================================
enum PropertyState {
  draft
  published
  paused
  archived
}

// =============================================================
// USERS
// =============================================================
model User {
  id         Int     @id @default(autoincrement())
  nombre     String
  correo     String  @unique
  email      String? @unique
  contrasena String
  telefono   String?
  ciudad     String?
  imagen     String?
  bio        String? @db.Text
  facebook   String?
  instagram  String?
  linkedin   String?
  web        String?
  whatsapp   String?
  tipoCuenta String  @default("Usuario")

  suscripcionNivel String @default("free")

  fechaRegistro    DateTime  @default(now())
  isActive         Boolean   @default(true)
  lastLogin        DateTime?
  resetCode        String?
  resetCodeExpires DateTime?

  publicaciones       Property[]
  empleos             Job[]                 @relation("UserJobs")
  favoritos           Favorite[]
  comentarios         Comment[]
  postulaciones       Application[]
  tickets             SupportTicket[]
  reservations        Reservation[]
  feedbacks           Feedback[]
  SubscriptionPayment SubscriptionPayment[]
  ActiveSubscription  ActiveSubscription[]
  invoices            Invoice[]
  Company             Company[]
  ratings             Rating[]
  reactions           Reaction[]
  portada             String?

  darkMode          Boolean @default(false)
  animacionesPerfil Boolean @default(true)
  mostrarPortada    Boolean @default(true)
  estiloTarjetas    String? @default("moderno")
  colorTema         String? @default("azul")
  fontSize          Float?  @default(1.0)

  perfilPrivado   Boolean @default(false)
  mostrarRedes    Boolean @default(true)
  mostrarContacto Boolean @default(true)

  profilePosts    ProfilePost[]
  profileLikes    ProfileLike[]
  profileComments ProfileComment[]
  notificaciones  Notificacion[]
  ventas          Venta[]
  reservaVentas   ReservaVenta[]
  resenaVentas    ResenaVenta[]
  favoritoVentas  FavoritoVenta[]

  @@index([tipoCuenta])
  @@index([fechaRegistro])
  @@index([resetCode])
}

// =============================================================
// VENTA
// =============================================================
model Venta {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  price       Float
  category    String
  type        String  @default("producto")

  image_url String?
  images    String[] @default([])
  video_url String?
  videos    String[] @default([])

  stock    Int?    @default(0)
  marca    String?
  modelo   String?
  color    String?
  estado   String? @default("Nuevo")     // <--- Estado del producto
  status   String  @default("published") // <--- Estado de PUBLICACIÓN

  featured Boolean @default(false)

  street    String?
  location  String?
  comuna    String?
  latitude  Float?
  longitude Float?
  metro     String?

  companyName String?
  contactName String?
  phone       String?
  email       String?
  whatsapp    String?
  website     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visitas  Int @default(0)   // ⭐ NECESARIO PARA ESTADÍSTICAS  

  userId Int
  user   User @relation(fields: [userId], references: [id])

  reservas  ReservaVenta[]
  resenas   ResenaVenta[]
  favoritos FavoritoVenta[]

  @@index([category])
  @@index([featured])
  @@index([comuna])
  @@index([price])
  @@index([createdAt])
}


// =============================================================
// COMPANY
// =============================================================
model Company {
  id            Int     @id @default(autoincrement())
  rutEmpresa    String?
  nombreEmpresa String
  correo        String  @unique
  contrasena    String?

  telefono    String?
  direccion   String?
  descripcion String?
  logo        String?

  encargado     String?
  dueno         String?
  horaApertura  String?
  horaCierre    String?
  diasOperacion String?
  sitioWeb      String?

  userId Int?  @db.Integer
  user   User? @relation(fields: [userId], references: [id])

  fechaRegistro DateTime @default(now())

  empleos     Job[]
  propiedades Property[]
  @@unique([userId])     // <— FIX CRÍTICO
  @@index([fechaRegistro])
}

// =============================================================
// PROPERTY
// =============================================================
model Property {
  id          Int     @id @default(autoincrement())
  titulo      String
  descripcion String
  precio      Float
  categoria   String
  tipo        String?

  imagen   String?
  images   String[] @default([])
  videoUrl String?
  videos   String[] @default([])

  street    String?
  location  String?
  comuna    String?
  metro     String?
  latitude  Float?
  longitude Float?

  stock    Int?
  marca    String?
  modelo   String?
  color    String?
  estado   String?
  featured Boolean @default(false)

  area        Int?
  dormitorios Int?
  banos       Int?
  anio        Int?

  fechaPublicacion DateTime @default(now())
  metadata         Json?

  companyName  String?
  contactName  String?
  contactPhone String?
  contactEmail String?
  whatsapp     String?
  website      String?

  visitas  Int           @default(0)
  reservas Int           @default(0)
  state    PropertyState @default(draft)
  status   String?
  views    Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    Int?
  companyId Int?

  user         User?         @relation(fields: [userId], references: [id])
  company      Company?      @relation(fields: [companyId], references: [id])
  comentarios  Comment[]
  favoritos    Favorite[]
  reservations Reservation[]
  ratings      Rating[]
  reactions    Reaction[]

  @@index([categoria])
  @@index([comuna])
  @@index([tipo])
  @@index([precio])
  @@index([fechaPublicacion])
  @@index([state])
  @@index([status])
  @@index([userId])
  @@index([companyId])
}

// =============================================================
// JOBS
// =============================================================
model Job {
  id               Int      @id @default(autoincrement())
  titulo           String
  descripcion      String
  categoria        String
  tipoContrato     String
  ubicacion        String
  salario          Float?
  fechaPublicacion DateTime @default(now())

  companyId Int?
  userId    Int?

  company       Company?      @relation(fields: [companyId], references: [id])
  user          User?         @relation("UserJobs", fields: [userId], references: [id])
  postulaciones Application[]
  favoritos     Favorite[]

  @@index([categoria])
  @@index([tipoContrato])
  @@index([fechaPublicacion])
}

// =============================================================
// APPLICATIONS
// =============================================================
model Application {
  id               Int      @id @default(autoincrement())
  userId           Int
  jobId            Int
  fechaPostulacion DateTime @default(now())
  estado           String   @default("En revisión")

  user User @relation(fields: [userId], references: [id])
  job  Job  @relation(fields: [jobId], references: [id])

  @@index([userId])
  @@index([jobId])
  @@index([estado])
  @@index([fechaPostulacion])
}

// =============================================================
// SUBSCRIPTIONS
// =============================================================
model Subscription {
  id           Int     @id @default(autoincrement())
  nombrePlan   String
  precio       Float
  descripcion  String?
  duracionDias Int
  nivel        String

  @@index([nivel])
}

// =============================================================
// FAVORITES
// =============================================================
model Favorite {
  id         Int  @id @default(autoincrement())
  userId     Int
  propertyId Int?
  jobId      Int?

  user     User      @relation(fields: [userId], references: [id])
  property Property? @relation(fields: [propertyId], references: [id])
  job      Job?      @relation(fields: [jobId], references: [id])

  @@index([userId])
  @@index([propertyId])
  @@index([jobId])
}

// =============================================================
// FAVORITO VENTA
// =============================================================
model FavoritoVenta {
  id        Int      @id @default(autoincrement())
  ventaId   Int
  userId    Int
  createdAt DateTime @default(now())

  venta Venta @relation(fields: [ventaId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([userId, ventaId], name: "userId_ventaId")
  @@index([ventaId])
  @@index([userId])
}

// =============================================================
// COMMENTS
// =============================================================
model Comment {
  id         Int      @id @default(autoincrement())
  contenido  String
  fecha      DateTime @default(now())
  userId     Int
  propertyId Int?

  user     User      @relation(fields: [userId], references: [id])
  property Property? @relation(fields: [propertyId], references: [id])

  @@index([userId])
  @@index([propertyId])
  @@index([fecha])
}

// =============================================================
// SUPPORT TICKETS
// =============================================================
model SupportTicket {
  id             Int      @id @default(autoincrement())
  subject        String
  description    String
  category       String?  @default("General")
  imageBase64    String?
  status         String   @default("Pendiente")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  userId         Int?
  user           User?    @relation(fields: [userId], references: [id])
  respuesta      String?  @db.Text
  documentBase64 String?
  documentName   String?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// =============================================================
// FEEDBACK
// =============================================================
model Feedback {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String?
  respuesta String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  userId    Int?

  user User? @relation(fields: [userId], references: [id])

  @@index([rating])
  @@index([createdAt])
}

// =============================================================
// FAQ
// =============================================================
model Faq {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String
  createdAt DateTime @default(now())
}

// =============================================================
// RESERVATIONS
// =============================================================
model Reservation {
  id         Int      @id @default(autoincrement())
  propertyId Int
  userId     Int
  startDate  DateTime
  endDate    DateTime
  message    String?  @db.Text
  people     Int      @default(1)
  status     String   @default("Pendiente")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([propertyId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// =============================================================
// COMMUNITY POSTS
// =============================================================
model CommunityPost {
  id        Int      @id @default(autoincrement())
  author    String
  title     String
  body      String
  createdAt DateTime @default(now())
}

// =============================================================
// SUBSCRIPTION PAYMENTS
// =============================================================
model SubscriptionPayment {
  id                Int       @id @default(autoincrement())
  userId            Int
  plan              String
  buyOrder          String
  token             String    @unique
  amount            Int
  status            String    @default("PENDING")
  paymentType       String?
  authorizationCode String?
  cardLast4         String?
  transactionDate   DateTime?
  confirmedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime? @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  invoices Invoice[]

  @@index([userId])
  @@index([plan])
  @@index([status])
  @@index([createdAt])
  @@index([token, status])
}

// =============================================================
// ACTIVE SUBSCRIPTIONS
// =============================================================
model ActiveSubscription {
  id     Int    @id @default(autoincrement())
  userId Int
  plan   String
  nivel  String @default("basic")

  startDate DateTime @default(now())
  endDate   DateTime
  autoRenew Boolean  @default(true)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, plan, status])
  @@index([userId])
  @@index([plan])
  @@index([status])
  @@index([endDate])
}

// =============================================================
// INVOICES
// =============================================================
model Invoice {
  id                Int      @id @default(autoincrement())
  userId            Int
  paymentId         Int
  pdfUrl            String
  amount            Int
  plan              String
  authorizationCode String?
  last4             String?
  createdAt         DateTime @default(now())

  user    User                @relation(fields: [userId], references: [id])
  payment SubscriptionPayment @relation(fields: [paymentId], references: [id])

  @@index([userId])
  @@index([paymentId])
}

// =============================================================
// RATINGS
// =============================================================
model Rating {
  id         Int      @id @default(autoincrement())
  score      Int
  userId     Int
  propertyId Int
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])

  @@unique([userId, propertyId])
  @@index([propertyId])
}

// =============================================================
// REACTIONS
// =============================================================
model Reaction {
  id         Int      @id @default(autoincrement())
  tipo       String
  userId     Int
  propertyId Int
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])

  @@unique([userId, propertyId, tipo])
  @@index([propertyId])
}

// =============================================================
// PROFILE POSTS
// =============================================================
model ProfilePost {
  id        Int     @id @default(autoincrement())
  userId    Int
  tipo      String  @default("text")
  texto     String
  titulo    String?
  imagen    String?
  video     String?
  miniatura String?
  duracion  Int?
  ubicacion String?
  tags      String?
  isPublic  Boolean @default(true)

  createdAt DateTime  @default(now())
  editedAt  DateTime?

  likes    ProfileLike[]
  comments ProfileComment[]

  repostId   Int?
  repost     ProfilePost?  @relation("RepostRelation", fields: [repostId], references: [id])
  repostedBy ProfilePost[] @relation("RepostRelation")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tipo])
  @@index([createdAt])
}

// =============================================================
// PROFILE LIKE
// =============================================================
model ProfileLike {
  id        Int      @id @default(autoincrement())
  userId    Int
  postId    Int
  createdAt DateTime @default(now())

  user User        @relation(fields: [userId], references: [id])
  post ProfilePost @relation(fields: [postId], references: [id])

  @@unique([userId, postId])
}

// =============================================================
// PROFILE COMMENT
// =============================================================
model ProfileComment {
  id         Int      @id @default(autoincrement())
  postId     Int
  userId     Int
  comentario String
  createdAt  DateTime @default(now())

  post ProfilePost @relation(fields: [postId], references: [id])
  user User        @relation(fields: [userId], references: [id])
}

// =============================================================
// NOTIFICACIONES
// =============================================================
model Notificacion {
  id        Int      @id @default(autoincrement())
  userId    Int
  tipo      String
  titulo    String
  mensaje   String
  refId     Int?
  leido     Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tipo])
  @@index([createdAt])
}

// =============================================================
// RESERVA VENTA
// =============================================================
model ReservaVenta {
  id      Int      @id @default(autoincrement())
  ventaId Int
  userId  Int
  fecha   DateTime @default(now())
  estado  String   @default("pendiente")
  meta      Json?    // 👈 AQUI ESTA LA PIEZA QUE FALTABA
  total     Int?      // ⭐ CAMPO NECESARIO PARA ESTADÍSTICAS
  venta Venta @relation(fields: [ventaId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@index([ventaId])
  @@index([userId])
  @@index([estado])
}

// =============================================================
// RESENA VENTA
// =============================================================
model ResenaVenta {
  id         Int      @id @default(autoincrement())
  ventaId    Int
  userId     Int
  puntuacion Int
  comentario String?
  respuesta  String?  @db.Text
  createdAt  DateTime @default(now())

  venta Venta @relation(fields: [ventaId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@index([ventaId])
  @@index([userId])
  @@index([puntuacion])
  @@index([createdAt])
}
